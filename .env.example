# FIREBASE_SERVICE_ACCOUNT_KEY: Base64 encoded service account JSON for Firebase Admin SDK.
# Optional if credentials.json is provided.
FIREBASE_SERVICE_ACCOUNT_KEY=

# VITE_FCM_VAPID_KEY: Firebase Console → Project Settings → Cloud Messaging →
# Web Push certificates → key pair. Required for browser push notifications
# (src/hooks/useFcmToken.ts). Without it, FCM registration is skipped.
VITE_FCM_VAPID_KEY=

# VITE_USE_EMULATOR: set to "1" to point the app at local Firestore/Auth
# emulators instead of production (used by Playwright e2e tests — see
# playwright.config.ts and tests/e2e/seed-mazeret.ts). Leave unset otherwise.
VITE_USE_EMULATOR=

# VITE_RECAPTCHA_SITE_KEY: Firebase Console → Project Settings → App Check →
# ezanmerkezi (web) → reCAPTCHA Enterprise site key. Bu bir SITE key'dir
# (public, istemci koduna gömülmesi güvenlidir — reCAPTCHA "secret key"iyle
# KARIŞTIRMAYIN, o asla client'a gitmez). Tanımsızsa App Check istemci
# tarafında hiç başlatılmaz (bkz. src/lib/firebase.ts) — App Check şu an
# yalnızca İZLEME modunda, hiçbir isteği reddetmez.
VITE_RECAPTCHA_SITE_KEY=

# DIYANET_API_EMAIL / DIYANET_API_PASSWORD: awqatsalah.diyanet.gov.tr resmi
# namaz vakti API'si için hesap kimlik bilgileri (bkz.
# scripts/lib/diyanetResmiApi.ts). Yalnızca Admin SDK cron script'lerinden
# (scripts/aylikEzanTakvimiGuncelle.ts, scripts/vakitVeriSagligiKontrol.ts)
# kullanılır — tarayıcıya ASLA gönderilmez/bundle edilmez. Tanımsız
# bırakılırsa bu katman sessizce atlanır ve mevcut public zincire
# (emushaf.net/Aladhan) düşülür, hiçbir şey bozulmaz.
DIYANET_API_EMAIL=
DIYANET_API_PASSWORD=
