rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ---------------------------------------------------------
    // GLOBALS & HELPERS
    // ---------------------------------------------------------
    // email_verified zorunlu: istemci yalnizca Google ile giris yapiyor (her
    // zaman dogrulanmis e-posta doner), ama konsolda Email/Sifre gibi baska
    // bir saglayici acikken bu kontrol olmasaydi dogrulanmamis bir e-postayla
    // (ornegin bir superAdminEmails girdisini taklit ederek) kimlik sahtekarligi
    // mumkun olurdu (bkz. mimari denetim K1).
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null &&
        request.auth.token.email_verified == true;
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // ÖNCEDEN saklı, opsiyonel `cumaMi` alanına (bkz. isValidBildirim) bakan
    // bir `.get('cumaMi', false)` idi — ama bu alan yalnızca belge
    // OLUŞTURULURKEN yazılıyor (self-update yolu `changed.hasOnly([...])`
    // ile cumaMi'yi hiç değiştiremiyor), yani asıl "eksikse Cuma değil say"
    // fail-open varsayımı, alanın eksik olduğu HER durumda (eski belge,
    // backfill öncesi, ileride eklenecek herhangi bir yazım yolunun alanı
    // unutması) Cuma kısıtlamasını sessizce atlatıyordu (bkz. kod denetimi:
    // firestore.rules güvenlik bulgusu). `tarih` (her zaman `isValidBildirim`
    // ile "YYYY-MM-DD", 10 karakter olarak doğrulanmış, hiçbir yazım yolunda
    // opsiyonel değil) üzerinden `haftaGunuNumarasi` ile doğrudan hesaplamak
    // — izinler'deki `izinAraligiCumaIceriyorMu` ile AYNI saf tarih
    // aritmetiği yaklaşımı — hem saklı alana duyulan güveni tamamen ortadan
    // kaldırır hem de eski regresyonun kök nedeni olan "eksik alanda undefined
    // erişim hatası" riskini taşımaz (tarih hiçbir zaman eksik olamaz).
    // Pazartesi=1 ... Pazar=7 ölçeğinde Cuma=5.
    function cumaMiIsaretli(data) {
      return haftaGunuNumarasi(data.tarih) == 5;
    }

    // ---------------------------------------------------------
    // 1 SAATLİK MAZERET/VEKALET PENCERESİ — SUNUCU TARAFI ZORLAYICI
    // ---------------------------------------------------------
    // KÖK NEDEN (kod denetimi): "ezan vaktine 1 saat kala pencere kapanır"
    // kuralı YALNIZCA istemcide (src/lib/mazeretKurallari.ts + iki servis)
    // uygulanıyordu ve `getTurkeyNow()`, RTDB zaman senkronu (src/lib/timeSync.ts)
    // hiç ateşlemezse — offline açılan bir PWA, engellenmiş/erişilemeyen RTDB —
    // `globalThis.__timeOffset` 0 kalacağından DOĞRUDAN CİHAZIN saatidir. Saati
    // 45 dakika geri alınmış bir cihaz, ezandan 30 dakika önce (kapalı olması
    // gereken pencerede) mazeret bildirebiliyor / vekalet teklifi açıp
    // kabul ettirebiliyordu; scripts/vekaletDevirleriniIsle.ts'in kendi kontrolü
    // "ezan ZATEN GEÇTİ Mİ" olduğundan (1 saatlik pencere DEĞİL) devri
    // uyguluyordu. İstemci saat senkronu bir UX kolaylığıdır, GÜVENLİK SINIRI
    // DEĞİLDİR.
    //
    // MİMARİ SEÇİM (bkz. iki alternatifin karşılaştırması):
    //  (a) SEÇİLEN — pencerenin KAPANDIĞI an, plan üretiminde (Admin SDK,
    //      güvenilir) önceden hesaplanıp `bildirimler.mazeretSonBasvuru`
    //      alanına gerçek bir `timestamp` olarak yazılır; kural yalnızca
    //      Firestore'un KENDİ sunucu saatiyle (`request.time` — istemci
    //      tarafından yazılamaz/etkilenemez) tek bir karşılaştırma yapar.
    //  (b) REDDEDİLEN — kuralın `vakitler/{ilceId}_{YYYY-MM}` belgesini okuyup
    //      "HH:MM" dizgesini CEL'de ayrıştırması. Bu, `settings/system` +
    //      `vakitler` için İKİ ek get() ve ~20 ek terim demekti; üstelik tam da
    //      bu dosyada belgeli "istek başına 1000 ifade" tavanına en yakın kural
    //      (`bildirimler` update) içinde. Ayrıca bozuk bir saat dizgesini
    //      (bkz. `normalizeVakitSaati`) CEL'de güvenle ele almak mümkün değil.
    // (a) bütün ayrıştırma/doğrulama yükünü güvenilir Admin SDK koduna taşır,
    // sabah istisnasını (yatsı+1sa) ve normal vakitleri TEK bir alanla aynı
    // şekilde ifade eder ve kuralı 3 terime indirir.
    //
    // FAIL-CLOSED: alan yoksa (eski belge, ezan verisi henüz yok, bozuk saat
    // dizgesi) pencere KAPALI sayılır. `cumaMi`'nin eski fail-open hatasının
    // (yukarıdaki yorum) tekrarlanmaması için bu bilinçli bir tercihtir; eksik
    // damgalar scripts/mazeretPenceresiBackfill.ts ile (10 dakikada bir)
    // tamamlanır.
    function mazeretPenceresiAcik(bildirimVeri) {
      let sonBasvuru = bildirimVeri.get('mazeretSonBasvuru', null);
      return sonBasvuru is timestamp && request.time < sonBasvuru;
    }

    // Süper-admin e-postaları config/bootstrap dokümanında tutulur (kaynak kodda
    // gömülü değildir). Doküman yoksa veya alan eksikse boş liste varsayılır.
    function isSuperAdminEmail(email) {
      return email != null &&
        exists(/databases/$(database)/documents/config/bootstrap) &&
        email in get(/databases/$(database)/documents/config/bootstrap).data.get('superAdminEmails', []);
    }

    function isAdmin() {
      return isSignedIn() && (
        isSuperAdminEmail(request.auth.token.email) ||
        (exists(/databases/$(database)/documents/muezzins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/muezzins/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // isAdmin()'in DAR alt kümesi: yalnızca config/bootstrap listesindeki
    // gerçek süper-adminler (muezzins.role == 'admin' TEK BAŞINA yetmez).
    // Geri alınamaz TOPLU SİLME işlemleri buna bağlanır — "admin panelini
    // görebilen herkes tüm hata/telemetri geçmişini silebilir" fazla geniş
    // bir yetkiydi (bkz. premium denetim P1.6). İstemci karşılığı:
    // useAuthStore `isSuperAdmin`.
    function isSuperAdmin() {
      return isSignedIn() && isSuperAdminEmail(request.auth.token.email);
    }

    // ---------------------------------------------------------
    // ENTITY: Duyurular
    // ---------------------------------------------------------
    // Diğer tüm yazılabilir varlıkların (muezzins, invites, vakitler,
    // bildirimler, vekalet_talepleri, error_logs, audit_logs,
    // telemetry_logs, settings, izinler) kendi şema doğrulayıcısı varken
    // duyurular hiç doğrulanmıyordu — yalnızca admin yazabildiğinden bir
    // yetki açığı değil, ama savunma derinliği tutarsızlığıydı (bkz. mimari
    // denetim — üçüncü tur). src/services/duyuruServisi.ts'in gerçek
    // create payload'ıyla (baslik, icerik, tip, tarih) birebir eşleşir;
    // `yazar` src/hooks/useDuyurular.ts'teki Duyuru tipinde opsiyonel
    // olarak tanımlı (henüz hiçbir yazım yolu kullanmıyor) — ileride
    // kullanılırsa reddedilmesin diye şemaya izinli alan olarak dahil edildi.
    function isValidDuyuru(data) {
      return data.keys().hasAll(['baslik', 'icerik', 'tip', 'tarih']) &&
             data.keys().hasOnly(['baslik', 'icerik', 'tip', 'tarih', 'yazar', 'bildirimGonderildi']) &&
             data.baslik is string && data.baslik.size() > 0 && data.baslik.size() <= 200 &&
             data.icerik is string && data.icerik.size() > 0 && data.icerik.size() <= 5000 &&
             data.tip in ['onemli', 'bilgi', 'duyuru'] &&
             data.tarih is timestamp &&
             // yazar diğer tüm serbest metin alanları (baslik, icerik) gibi
             // uzunluk sınırı olmadan bırakılmıştı — bugün yalnızca admin
             // yazabildiğinden sömürülebilir değil, ama bu alan ileride
             // (yorumda belirtildiği gibi) doldurulmaya başlarsa hiçbir şey
             // sınırsız uzunlukta bir değeri engellemiyordu (bkz. code-review,
             // dördüncü denetim turu).
             (!data.keys().hasAny(['yazar']) || (data.yazar is string && data.yazar.size() <= 100)) &&
             // bildirimGonderildi: duyuruYayinla oluşturma anında `false`
             // yazar, scripts/duyuruBildirimGonder.ts (Admin SDK — bu kural
             // ATLANIR) push gönderdikten sonra `true`'ya çevirir. Alan
             // yalnızca Admin SDK tarafından true'ya çevrilse de, `update`
             // kuralı da isValidDuyuru çağırdığından (şu an istemcide bir
             // "duyuru düzenle" akışı olmasa bile) ileride biri eklenirse bu
             // alan sessizce "fazladan anahtar" ihlaliyle reddedilmesin diye
             // burada tipli olarak listelenir.
             (!data.keys().hasAny(['bildirimGonderildi']) || data.bildirimGonderildi is bool) &&
             // bildirimGonderimBaslangici: duyuruBildirimGonder.ts'in iki
             // fazlı "gönderiliyor" damgası (bkz. scripts/lib/gonderimClaim.ts).
             // Normalde 3. FAZ'da silinir, ama süreç ölürse belgede kalır —
             // `bildirimGonderildi` ile AYNI gerekçeyle burada listelenmek
             // ZORUNDA, aksi halde damgayı taşıyan bir duyuruya yapılan her
             // istemci update'i "fazladan anahtar" ihlaliyle reddedilirdi.
             (!data.keys().hasAny(['bildirimGonderimBaslangici']) || data.bildirimGonderimBaslangici is timestamp);
    }

    match /duyurular/{duyuruId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() && isValidDuyuru(incoming());
      allow delete: if isAdmin();
    }

    // ENTITY: Muezzins
    function isValidMuezzin(data) {
      // `email` KASITLI OLARAK zorunlu alanlar arasında DEĞİL — üretimde
      // müezzins koleksiyonunun büyük çoğunluğu (personelKaydet'in "yeni
      // personel" dalı yalnızca invites/{email} yazar; muezzins belgesi
      // ancak kişi isInvitedSelfMuezzinCreate ile KENDİSİ giriş yaptığında
      // oluşur) hiç kendi hesabıyla giriş yapmamış, yalnızca çizelgede yer
      // alan personel — bunların email alanı hiç yok. Bu alan eskiden
      // hasAll(...) ile zorunlu tutuluyordu; incoming() bir update'te TAM
      // birleşmiş belgeyi temsil ettiğinden, bu, email'i olmayan HERHANGİ
      // bir personele yapılan (aktiflik/arşiv/isim/rol/kadro sayacı gibi
      // email'le ilgisiz) her updateDoc'un PERMISSION_DENIED almasına yol
      // açıyordu (bkz. veriSifirlamaServisi.ts kadroSayaclariniSifirla
      // hata denetimi — prod'da 15/17 belge email'siz çıktı). email VAR
      // olduğunda hâlâ şekli doğrulanır (photoURL/fcmToken ile aynı
      // "opsiyonel ama varsa geçerli olmalı" deseni); self-registration
      // (isInvitedSelfMuezzinCreate) zaten create anında email'i ayrıca
      // zorunlu kılıyor.
      return data.keys().hasAll(['displayName', 'aktif', 'role']) &&
             data.keys().hasOnly([
               'displayName', 'aktif', 'role', 'email', 'photoURL', 'fcmToken', 'fcmTokens',
               'aylikVakitSayisi', 'aylikCumaSayisi', 'aylikYedekSayisi', 'toplamVakitSayisi', 'yillikIzinKullanilanGun',
               'haftalikIzinGunu', 'notificationSettings',
               'onayBekliyor', 'kayitTarihi', 'arsivlendi', 'arsivTarihi'
             ]) &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.role in ['admin', 'muezzin', 'gozlemci'] &&
             (!data.keys().hasAny(['email']) || (data.email is string && data.email.size() <= 100)) &&
             data.aktif is bool &&
             (!data.keys().hasAny(['photoURL']) || data.photoURL is string) &&
             (!data.keys().hasAny(['fcmToken']) || data.fcmToken is string || data.fcmToken == null) &&
             (!data.keys().hasAny(['fcmTokens']) || isValidFcmTokens(data.fcmTokens)) &&
             (!data.keys().hasAny(['aylikVakitSayisi']) || (data.aylikVakitSayisi is int && data.aylikVakitSayisi >= 0)) &&
             (!data.keys().hasAny(['aylikCumaSayisi']) || (data.aylikCumaSayisi is int && data.aylikCumaSayisi >= 0)) &&
             (!data.keys().hasAny(['aylikYedekSayisi']) || (data.aylikYedekSayisi is int && data.aylikYedekSayisi >= 0)) &&
             // aylikVakitSayisi'nin AKSİNE her ayın 1'inde sıfırlanmaz (bkz.
             // scripts/yatsiSonuIslemleri.ts) — ProfileBadges.tsx'teki hizmet
             // rozetleri bu kalıcı toplam üzerinden kazanılır/korunur.
             (!data.keys().hasAny(['toplamVakitSayisi']) || (data.toplamVakitSayisi is int && data.toplamVakitSayisi >= 0)) &&
             // Yıllık izin kotası (takvim yılı başına 30 gün) — bu üst sınır
             // SERT bir engeldir, admin de aşamaz (kullanıcı kararı). Sayaç
             // her 1 Ocak'ta scripts/yatsiSonuIslemleri.ts tarafından
             // sıfırlanır (bkz. src/store/useAdminIzinlerStore.ts izinGuncelle).
             (!data.keys().hasAny(['yillikIzinKullanilanGun']) || (data.yillikIzinKullanilanGun is int && data.yillikIzinKullanilanGun >= 0 && data.yillikIzinKullanilanGun <= 30)) &&
             // 5 (Cuma) hariç — PersonelFormModal.tsx bu seçeneği bilinçli
             // olarak devre dışı bırakır çünkü planlamaCekirdegi.ts
             // haftalikIzinGunu'nu kalıcı bir "bu kişi asla Cuma'ya
             // atanmaz" dışlaması olarak kullanır (bkz. isFixedDayOff);
             // sunucu tarafında bu kısıt yoktu (bkz. mimari denetim).
             (!data.keys().hasAny(['haftalikIzinGunu']) || (data.haftalikIzinGunu is int && data.haftalikIzinGunu >= 0 && data.haftalikIzinGunu <= 7 && data.haftalikIzinGunu != 5)) &&
             (!data.keys().hasAny(['notificationSettings']) || isValidNotificationSettings(data.notificationSettings)) &&
             (!data.keys().hasAny(['onayBekliyor']) || data.onayBekliyor is bool) &&
             (!data.keys().hasAny(['kayitTarihi']) || data.kayitTarihi is string) &&
             (!data.keys().hasAny(['arsivlendi']) || data.arsivlendi is bool) &&
             (!data.keys().hasAny(['arsivTarihi']) || data.arsivTarihi == null || data.arsivTarihi is timestamp);
    }

    function isValidNotificationSettings(settings) {
      return settings is map &&
             settings.keys().hasOnly(['nobetHatirlatici', 'duyurular', 'mazeretDurumu']) &&
             (!settings.keys().hasAny(['nobetHatirlatici']) || settings.nobetHatirlatici is bool) &&
             (!settings.keys().hasAny(['duyurular']) || settings.duyurular is bool) &&
             (!settings.keys().hasAny(['mazeretDurumu']) || settings.mazeretDurumu is bool);
    }

    function isValidFcmTokens(tokens) {
      return tokens is map && tokens.size() <= 20;
    }

    function isInvitedSelfMuezzinCreate(uid) {
      let emailId = request.auth.token.email.lower();
      let invite = get(/databases/$(database)/documents/invites/$(emailId)).data;
      return isSignedIn() &&
             request.auth.uid == uid &&
             incoming().email == emailId &&
             exists(/databases/$(database)/documents/invites/$(emailId)) &&
             incoming().role == invite.role &&
             // İstemci (useAuthStore.ts) kendi profilini oluştururken admin
             // rolü hariç her zaman onayBekliyor:true yazar — bu kısıt
             // olmadan kişi kendi profilini onayBekliyor:false ile
             // oluşturup admin onayı beklemeden doğrudan nöbete
             // atanabiliyordu (bkz. mimari denetim Y4).
             (incoming().role == 'admin' ? incoming().get('onayBekliyor', false) != true : incoming().get('onayBekliyor', false) == true);
    }

    match /muezzins/{uid} {
      allow get, list: if isSignedIn();
      allow create: if isValidMuezzin(incoming()) && (isAdmin() || isInvitedSelfMuezzinCreate(uid));
      allow delete: if isAdmin();
      allow update: if isSignedIn() && isValidMuezzin(incoming()) && (
        isAdmin() || (
            request.auth.uid == uid && 
            incoming().email == existing().email && 
            incoming().role == existing().role &&
            incoming().aktif == existing().aktif &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'fcmToken', 'fcmTokens', 'notificationSettings']) &&
            (!incoming().keys().hasAny(['notificationSettings']) || isValidNotificationSettings(incoming().notificationSettings)) &&
            (!incoming().keys().hasAny(['fcmTokens']) || isValidFcmTokens(incoming().fcmTokens))
        )
      );
    }

    // ---------------------------------------------------------
    // ENTITY: Invites
    // ---------------------------------------------------------
    function isValidInvite(data) {
      return data.keys().hasAll(['email', 'role']) &&
             data.keys().hasOnly(['email', 'displayName', 'role', 'haftalikIzinGunu', 'olusturmaTarihi']) &&
             data.email is string && data.email.size() <= 100 &&
             data.role in ['admin', 'muezzin', 'gozlemci'] &&
             (!data.keys().hasAny(['displayName']) || (data.displayName is string && data.displayName.size() <= 100)) &&
             // isValidMuezzin ile aynı Cuma (5) hariç tutması — bu alan
             // kabul edilecek daveti self-registration'da doğrudan
             // muezzins doc'una kopyalanır (bkz. useAuthStore.ts).
             (!data.keys().hasAny(['haftalikIzinGunu']) || (data.haftalikIzinGunu is int && data.haftalikIzinGunu >= 1 && data.haftalikIzinGunu <= 7 && data.haftalikIzinGunu != 5));
    }

    match /invites/{emailId} {
      allow list: if isAdmin();
      allow get: if isSignedIn() && (isAdmin() || request.auth.token.email.lower() == emailId.lower());
      allow create, update: if isAdmin() && isValidInvite(incoming()) && incoming().email.lower() == emailId.lower();
      allow delete: if isAdmin() || (isSignedIn() && request.auth.token.email.lower() == emailId.lower());
    }

    // ---------------------------------------------------------
    // ENTITY: Vakitler
    // ---------------------------------------------------------
    function isValidVakitCache(data) {
      return data.keys().hasAll(['ilceId', 'gunler', 'kaynakApi', 'guncellenmeTarihi']) &&
             data.keys().hasOnly(['ilceId', 'gunler', 'kaynakApi', 'guncellenmeTarihi']) &&
             data.ilceId is string && data.ilceId.size() >= 3 && data.ilceId.size() <= 8 &&
             data.ilceId.matches('^[0-9]+$') &&
             // Alt sınır önceden 28'di ("her zaman tam bir ay yazılır" varsayımı) ama
             // src/services/ezanVaktiServisi.ts aylikVakitleriGrupla, API'nin bugünden
             // itibaren döndürdüğü kayan pencereyi gerçek takvim ayına göre böldüğünden,
             // İÇİNDE BULUNULAN ay için kasıtlı olarak PARTIAL bir grup üretir (ör. ayın
             // 10'unda senkronize edilirse o ay yalnızca ~20 gün içerir). Bu, ilk kez
             // senkronize edilen bir ilçede (bkz. SistemAyarlari.tsx ilçe değişikliği)
             // ayın neredeyse HER gününde bu yazımı reddediyordu (bkz. mantık denetimi).
             data.gunler is map && data.gunler.size() >= 1 && data.gunler.size() <= 32 &&
             // 'diyanet-resmi' = awqatsalah.diyanet.gov.tr resmi servisi
             // (bkz. scripts/lib/diyanetResmiApi.ts) — 'diyanet' (emushaf.net
             // proxy'si) ve 'aladhan' fallback'larına ek üçüncü kaynak.
             data.kaynakApi in ['diyanet', 'diyanet-resmi', 'aladhan'] &&
             data.guncellenmeTarihi is timestamp;
    }

    match /vakitler/{docId} {
      allow get, list: if isSignedIn();
      allow write: if isAdmin() && isValidVakitCache(incoming());
    }

    // ---------------------------------------------------------
    // ENTITY: Hafta Planları
    // ---------------------------------------------------------
    match /haftaPlanlari/{docId} {
      allow read, list: if isSignedIn();
      allow create, delete: if isAdmin();
      // Only admins can update the plan. Swaps should be handled via a secure process.
      allow update: if isAdmin(); 
    }

    // ---------------------------------------------------------
    // ENTITY: Bildirimler
    // ---------------------------------------------------------
    // NOT (ifade tavanı denetimi — 3. tur, KÖK NEDEN ÇÖZÜMÜ): bu kural
    // eskiden 4 ağır dal OR'luyordu (self-update, vekalet-kabul TRANSFERİ,
    // yedek-terfi, admin) ve emülatörün "istek başına 1000 ifade" bütçesine
    // en basit tek-alan self-update yazımında bile çarpıyordu — üç bağımsız
    // araştırma (resmi Firebase dokümantasyonu + kod haritası + test kanıtı)
    // bunun çalışma-zamanı kısa-devre davranışından değil, 4 dalın TOPLAM
    // derlenmiş karmaşıklığından (~160-180 terim) kaynaklandığını kanıtladı
    // (iki bağımsız çalışma-zamanı optimizasyonu — get() paylaşımı, admin
    // dalını sona alma — SIFIR etki yaptı, 13→13). Kusursuz çözüm bu yüzden
    // "daha ucuz sırala" değil "gerçek doğrulama yükünü CEL'den çıkar" oldu:
    // vekalet-kabul TRANSFERİ (bildirimler.uid flip'i) ve mazeret-reddi
    // sonrası yedek-terfi artık istemci tarafında DEĞİL, Admin SDK ile
    // çalışan scripts/vekaletDevirleriniIsle.ts / mazeretDevirleriniIsle.ts
    // içinde (kural bütçesi yok, düz TypeScript) gerçekleşiyor — bkz. plan
    // dosyası "sorunun-k-k-kayna..." (1000 ifade tavanı kök neden analizi).
    // İstemci yalnızca dar, ucuz bir "niyet" bayrağı yazabiliyor
    // (isVekaletDevriBekliyorIsareti). Kalan 3 dal (self-update, vekalet-
    // bayrağı, admin) toplamda eskisinin küçük bir kesri kadar terim
    // içeriyor. `existing().uid == request.auth.uid` hâlâ ucuz bir
    // FONKSİYON ÇAĞRISI sınırında kontrol edilir (ayrı bir `let` değil) —
    // başkasının belgesini güncellemeye çalışan HER istek burada hiç
    // Firestore okumadan elenir.
    function isSelfBildirimUpdate(docId) {
      return existing().uid == request.auth.uid && isSelfBildirimUpdateIcin(docId);
    }

    function isSelfBildirimUpdateIcin(docId) {
      let changed = incoming().diff(existing()).affectedKeys();
      // devirSonucu opsiyonel alan (bkz. isValidBildirim) — mazeret
      // reddi/onayı dışındaki hiçbir bildirimde hiç set edilmemiş olabilir.
      // `.get(key, default)` ile okunmazlarsa alan tümüyle eksikken doğrudan
      // `incoming().devirSonucu` erişimi rules motorunda "Property is
      // undefined" hatası fırlatıyordu (bkz. `cumaMiIsaretli`/
      // `isBackupPromotionFromMazeret` ile aynı kalıp).
      let devirSonucu = incoming().get('devirSonucu', null);
      // mazeret_detaylari koleksiyonunda BU belgeyle AYNI ID'ye (docId —
      // match bloğunun kendi wildcard'ı) sahip bir kayıt, reddi bildiren
      // tarafın özel mazeret gerekçesini (retSebebi) taşır. Önceden retSebebi
      // doğrudan BU belgede (bildirimler) tutuluyordu; bildirimler
      // `allow read, list: if isSignedIn()` ile (haftalık çizelgeyi TÜM
      // ekibin görebilmesi için GEREKLİ) açık kalmak zorunda olduğundan, bu
      // da retSebebi'yi istemeden herkese açıyordu — normal haftalık çizelge
      // sorgusunda bile pasif olarak sızıyordu, ve admin-only "Mazeret
      // Geçmişi" ekranının sorgusu herhangi bir kullanıcı tarafından
      // konsoldan birebir tekrarlanabiliyordu (bkz. mimari denetim — altıncı
      // tur). retSebebi artık ayrı, yalnızca ilgili kişi+admin'in
      // okuyabildiği mazeret_detaylari koleksiyonuna taşındı; bir getAfter()
      // korelasyonu bu belgenin GERÇEKTEN aynı commit'te yazıldığını
      // doğrular (eşleşen belge yoksa/uid uyuşmazsa değerlendirme hatasıyla
      // fail-closed reddeder — dosyada zaten kurulu bir desen). NOT: docId,
      // bildirimler'in kendi belgesinin GERÇEK ID'sidir — üretimde her zaman
      // deterministik (haftaId_tarih_vakit_tip) olsa da, bu alanlardan
      // yeniden hesaplamak yerine doğrudan kullanmak daha güvenilir (ör.
      // test fixture'ları gibi bu kalıba uymayan ID'lerde de doğru çalışır).
      // Bu, artık bu kuraldaki TEK getAfter() korelasyonu — yedek-terfi
      // çapraz-doğrulaması (bkz. altta) kaldırıldı, o iş artık
      // scripts/mazeretDevirleriniIsle.ts'te.
      let mazeretDetay = getAfter(/databases/$(database)/documents/mazeret_detaylari/$(docId)).data;
      return existing().uid == request.auth.uid &&
             incoming().uid == existing().uid &&
             incoming().haftaId == existing().haftaId &&
             incoming().tarih == existing().tarih &&
             incoming().vakit == existing().vakit &&
             incoming().tip == existing().tip &&
             changed.hasOnly(['durum', 'pendingAck', 'sonGuncelleme', 'devirSonucu']) &&
             // 1 saatlik mazeret penceresi — SUNUCU saatiyle (bkz.
             // `mazeretPenceresiAcik` yorumu). Yalnızca mazeret (reddedildi)
             // yolunu kapsar: "okudum" onayı (bekliyor→onaylandi) bir mazeret
             // değildir, ezandan sonra bile yapılabilmelidir. Tek bir yerde
             // (iki reddedildi dalının ORTAK önkoşulu olarak) yazıldı —
             // `bildirimler` update kuralının belgeli ifade bütçesi için.
             (incoming().durum == 'onaylandi' || mazeretPenceresiAcik(existing())) &&
             // Diğer zaman damgası alanları gibi (bkz. isValidBildirim)
             // sonGuncelleme burada da tiplenmemişti — gerçek çağıranlar
             // zaten serverTimestamp() gönderiyor ama sema doğrulaması
             // tutarlı olmalı (bkz. mimari denetim — üçüncü tur).
             incoming().sonGuncelleme is timestamp &&
             (
               (
                 existing().durum == 'bekliyor' &&
                 incoming().durum == 'onaylandi' &&
                 incoming().pendingAck == false &&
                 !changed.hasAny(['devirSonucu'])
               ) ||
               (
                 existing().durum == 'bekliyor' &&
                 existing().tip == 'asil' &&
                 // Cuma gunleri mazeret/gorev devri kullanilamaz (bkz. ayni
                 // kisitlamanin izin taleplerindeki karsiligi:
                 // src/components/VacationRequestCard.tsx ve istemci tarafi
                 // ayna kural: src/lib/mazeretKurallari.ts).
                 !cumaMiIsaretli(existing()) &&
                 incoming().durum == 'reddedildi' &&
                 incoming().pendingAck == false &&
                 mazeretDetay.uid == request.auth.uid &&
                 // `devirSonucu` artık istemcinin yalnızca bir İPUCU olarak
                 // yazdığı, YETKİLENDİRİCİ olmayan bir alan — yedeğin
                 // GERÇEKTEN terfi edip etmediğini bu kural artık doğrulamaz
                 // (o korelasyon, aynı-commit garantisi gerektirdiğinden ve
                 // pahalı bir getAfter() olduğundan, scripts/
                 // mazeretDevirleriniIsle.ts'e taşındı — orada Admin SDK ile
                 // taze veriden yeniden doğrulanıyor, istemcinin yazdığı
                 // değere güvenilmiyor). Bu asil belgenin kendisi için tek
                 // önemli olan, durum geçişinin (bekliyor→reddedildi) ve
                 // mazeretDetay korelasyonunun geçerli olması.
                 devirSonucu in ['alarm_bekliyor', 'yedek_atandi']
               ) ||
               (
                 // Yedek görevli kendi mazeretini bildiriyor — devralacak bir
                 // "yedeğin yedeği" olmadığından doğrudan admin alarmına
                 // düşer (bkz. src/services/mazeretServisi.ts, scripts/
                 // mazeretDevirleriniIsle.ts).
                 existing().durum == 'bekliyor' &&
                 existing().tip == 'yedek' &&
                 !cumaMiIsaretli(existing()) &&
                 incoming().durum == 'reddedildi' &&
                 incoming().pendingAck == false &&
                 mazeretDetay.uid == request.auth.uid &&
                 devirSonucu == 'alarm_bekliyor'
               )
             ) &&
             // NOT (premium denetim P1.5 — 'gozlemci' salt-okuma): burada
             // AYRICA bir `role != 'gozlemci'` şartı EKLENMEDİ, çünkü
             // isAssignableDutyUid zaten `role == 'muezzin'` arıyor — bu,
             // aranan kısıtın KATI ÜST KÜMESİ (gozlemci de admin de elenir).
             // Redundant bir terim eklemek, bu dosyada belgeli "1000 ifade
             // tavanı" bütçesinin en sıkı olduğu kuralı (bildirimler update)
             // hiçbir güvenlik kazancı olmadan büyütürdü. Regresyon testi:
             // scripts/firestore-rules-tests.ts "gozlemci bildirim
             // self-update yapamaz".
             isAssignableDutyUid(request.auth.uid);
    }

    // NOT (ifade tavanı denetimi — 3. tur, KÖK NEDEN ÇÖZÜMÜ): yedek görevlinin
    // 'asil' rolüne terfisi eskiden burada, `bildirimler` update kuralının bir
    // dalı olarak, aynı transaction içinde çapraz-doğrulanıyordu (getAfter()
    // ile asil belgenin GERÇEKTEN 'reddedildi' olduğunu kontrol ederek). Bu
    // dal (isBackupPromotionFromMazeret/Icin) TAMAMEN SİLİNDİ — istemci artık
    // yedek belgeye HİÇ dokunmuyor (bkz. src/services/mazeretServisi.ts,
    // yedek write kaldırıldı); terfi artık Admin SDK ile çalışan
    // scripts/mazeretDevirleriniIsle.ts'te, taze veriyle yeniden doğrulanarak
    // gerçekleşiyor. Sonuç: bu koleksiyonda yedek belgenin `tip` alanını
    // client-side değiştirebilecek HİÇBİR dal kalmadı (isSelfBildirimUpdate
    // yalnızca `existing().uid == request.auth.uid` olan belgeleri kapsar,
    // yedek belge başka birinin belgesidir) — client'tan gelen böyle bir
    // yazım artık koşulsuz reddedilir.

    function vekaletTalepId(data) {
      return data.haftaId + '_' + data.tarih + '_' + data.vakit + '_' + data.tip + '_' + data.aliciUid;
    }

    function isVekaletParticipant(data) {
      return isSignedIn() && (data.gonderenUid == request.auth.uid || data.aliciUid == request.auth.uid);
    }

    function isValidVekaletTalebi(data) {
      return data.keys().hasAll([
               'bildirimId', 'haftaId', 'gonderenUid', 'gonderenIsim',
               'aliciUid', 'aliciIsim', 'tarih', 'vakit', 'saat',
               'tip', 'durum', 'olusturmaTarihi'
             ]) &&
             data.keys().hasOnly([
               'bildirimId', 'haftaId', 'gonderenUid', 'gonderenIsim',
               'aliciUid', 'aliciIsim', 'tarih', 'vakit', 'saat',
               'tip', 'durum', 'olusturmaTarihi', 'sonGuncelleme'
             ]) &&
             data.bildirimId is string &&
             data.haftaId is string &&
             data.gonderenUid == request.auth.uid &&
             data.gonderenIsim is string && data.gonderenIsim.size() > 0 && data.gonderenIsim.size() <= 120 &&
             data.aliciUid is string && data.aliciUid != request.auth.uid &&
             data.aliciIsim is string && data.aliciIsim.size() > 0 && data.aliciIsim.size() <= 120 &&
             data.tarih is string && data.tarih.size() == 10 &&
             data.vakit in ['sabah', 'ogle', 'ikindi', 'aksam', 'yatsi'] &&
             data.saat is string && data.saat.size() >= 4 && data.saat.size() <= 5 &&
             data.tip in ['asil', 'yedek', 'gorev_cagrisi'] &&
             data.durum == 'beklemede';
    }

    function isValidVekaletCreate(talepId) {
      let bildirim = get(/databases/$(database)/documents/bildirimler/$(incoming().bildirimId)).data;
      let alici = get(/databases/$(database)/documents/muezzins/$(incoming().aliciUid)).data;
      // GÖNDEREN'in rolü de doğrulanır (bkz. premium denetim P1.5,
      // 'gozlemci' salt-okuma): alıcı için zaten `alici.role == 'muezzin'`
      // aranıyordu ama gönderen tarafında yalnızca "bu bildirim benim mi"
      // kontrolü vardı. Bildirim OLUŞTURMA anında isValidBildirim
      // (isAssignableDutyUid) rolü zorunlu kılsa da, rol SONRADAN
      // 'gozlemci'ye çekilebilir — o kişinin ESKİ bildirimleri üzerinden
      // hâlâ vekalet teklifi açabilmesi salt-okuma sözünü deler. `!=
      // 'gozlemci'` (== 'muezzin' değil) bilinçli: mevcut hiçbir meşru
      // akışı daraltmadan yalnızca gözlemciyi eler.
      let gonderen = get(/databases/$(database)/documents/muezzins/$(request.auth.uid)).data;
      return isValidVekaletTalebi(incoming()) &&
             gonderen.role != 'gozlemci' &&
             talepId == vekaletTalepId(incoming()) &&
             bildirim.uid == request.auth.uid &&
             bildirim.haftaId == incoming().haftaId &&
             bildirim.tarih == incoming().tarih &&
             bildirim.vakit == incoming().vakit &&
             bildirim.tip == incoming().tip &&
             bildirim.durum == 'bekliyor' &&
             // Cuma gorevleri vekalet ile de devredilemez — aksi halde
             // mazeret icin uygulanan Cuma kisitlamasi bu yoldan atlatilabilir
             // (bkz. algoritma denetimi).
             !cumaMiIsaretli(bildirim) &&
             // 1 saatlik pencere — teklif AÇMA anı (bkz. `mazeretPenceresiAcik`
             // yorumu). `bildirim` zaten yukarıda get() edildi: ek okuma YOK.
             // Damga TALEP belgesine KOPYALANMAZ, her zaman bildirimden okunur:
             // kopyalanan bir alan sonradan desenkronize olabilirdi (bkz.
             // `vekalet_talepleri` update kuralındaki admin dalının aynı sınıf
             // riski ve scripts/vekaletDevirleriniIsle.ts'in tek-kaynak düzeltmesi).
             mazeretPenceresiAcik(bildirim) &&
             alici.role == 'muezzin' &&
             alici.aktif == true;
    }

    // Admin'in bir vekalet talebinde DEĞİŞTİREMEYECEĞİ alanlar (bkz.
    // `vekalet_talepleri` update kuralındaki gerekçe). `bildirimId` dahil tüm
    // korelasyon anahtarları ve taraflar sabit kalır — böylece bir talebin
    // hangi bildirime/güne/vakte ait olduğu, oluşturma anında
    // `isValidVekaletCreate`'in doğruladığı halinden asla sapamaz.
    function isAdminVekaletUpdate() {
      return incoming().diff(existing()).unchangedKeys().hasAll([
               'bildirimId', 'haftaId', 'gonderenUid', 'aliciUid',
               'tarih', 'vakit', 'tip', 'olusturmaTarihi'
             ]) &&
             incoming().durum in ['beklemede', 'kabul_edildi', 'reddedildi'];
    }

    // Vekalet KABULÜ (`vekalet_talepleri.durum` -> 'kabul_edildi') için 1
    // saatlik pencere kontrolü. `isVekaletDevriBekliyorIsareti` aynı kabulün
    // bildirim tarafını zaten kapatıyor, ama scripts/vekaletDevirleriniIsle.ts
    // GERÇEK transferi yalnızca `vekalet_talepleri.durum == 'kabul_edildi'`
    // sorgusuyla bulur (bildirimdeki niyet bayrağını ŞART KOŞMAZ) — yani tek
    // başına bu durum yazımı da transferi tetikleyebilir. Bu yüzden iki yazım
    // da ayrı ayrı kapatılmalıdır.
    function vekaletKabulPenceresiAcik(bildirimId) {
      let yol = /databases/$(database)/documents/bildirimler/$(bildirimId);
      // exists() ile kısa devre: silinmiş bir bildirime ait talep için get()
      // hiç çalışmaz (bkz. isAssignableDutyUid'deki aynı desen) ve pencere
      // kapalı sayılır (fail-closed).
      return exists(yol) && mazeretPenceresiAcik(get(yol).data);
    }

    function isRecipientVekaletStatusUpdate() {
      let changed = incoming().diff(existing()).affectedKeys();
      return isSignedIn() &&
             existing().aliciUid == request.auth.uid &&
             existing().durum == 'beklemede' &&
             incoming().diff(existing()).unchangedKeys().hasAll([
               'bildirimId', 'haftaId', 'gonderenUid', 'gonderenIsim',
               'aliciUid', 'aliciIsim', 'tarih', 'vakit', 'saat',
               'tip', 'olusturmaTarihi'
             ]) &&
             changed.hasOnly(['durum', 'sonGuncelleme']) &&
             incoming().durum in ['kabul_edildi', 'reddedildi'] &&
             // REDDETME her zaman serbesttir (pencere kapandıktan sonra da
             // alıcı teklifi geri çevirebilmelidir); yalnızca KABUL, sunucu
             // saatiyle doğrulanan 1 saatlik pencereye tabidir. `||` kısa
             // devresi sayesinde red yolunda hiç get() yapılmaz.
             (incoming().durum == 'reddedildi' || vekaletKabulPenceresiAcik(existing().bildirimId));
    }

    // NOT (ifade tavanı denetimi — 3. tur, KÖK NEDEN ÇÖZÜMÜ): vekalet-kabul
    // TRANSFERİ (bildirimler.uid flip'i + talep korelasyonu + atanabilirlik/
    // Cuma/izin-günü yeniden doğrulaması) eskiden burada, ~45 terimlik ve
    // getAfter() içeren pahalı bir dal olarak yaşıyordu. Artık istemci bu
    // transferi HİÇ yapmıyor — yalnızca dar bir "niyet" bayrağı yazıyor
    // (bkz. src/services/vekaletServisi.ts, vekaletKabulEt artık yalnızca
    // vekalet_talepleri.durum='kabul_edildi' + bu bayrağı yazar). Gerçek
    // transfer, tüm iş kurallarını (atanabilirlik, Cuma, izin-günü) taze
    // veriyle TypeScript'te yeniden doğrulayan scripts/vekaletDevirleriniIsle.ts
    // içinde, Admin SDK ile (kural bütçesi yok) gerçekleşiyor. Bu fonksiyon
    // yalnızca "eşleşen, kabul edilmiş bir talep var mı" diye TEK bir ucuz
    // get() yapar (getAfter DEĞİL — talep bu commit'te değil, ÖNCEDEN
    // yazılmış bir belge).
    function isVekaletDevriBekliyorIsareti(docId) {
      return existing().durum == 'bekliyor' &&
             existing().uid != request.auth.uid &&
             isVekaletDevriBekliyorIsaretiIcin(docId);
    }

    function isVekaletDevriBekliyorIsaretiIcin(docId) {
      let changed = incoming().diff(existing()).affectedKeys();
      let talepId = existing().haftaId + '_' + existing().tarih + '_' + existing().vakit + '_' + existing().tip + '_' + request.auth.uid;
      // `getAfter()` (get() DEĞİL) zorunlu: src/services/vekaletServisi.ts
      // `vekaletKabulEt` talebi 'kabul_edildi'ye çeviren yazım İLE bu bildirim
      // bayrağı yazımını AYNI transaction'da yapar — `get()` bu commit'ten
      // ÖNCEKİ (hâlâ 'beklemede') durumu görürdü, korelasyonu her zaman false
      // yapardı. Yine de tek bir getAfter() — silinen ~45 terimlik dalın
      // yanında ihmal edilebilir bir maliyet.
      let talep = getAfter(/databases/$(database)/documents/vekalet_talepleri/$(talepId)).data;
      return changed.hasOnly(['vekaletDevriBekliyor', 'sonGuncelleme']) &&
             incoming().vekaletDevriBekliyor == true &&
             incoming().sonGuncelleme is timestamp &&
             // Vekalet KABULÜ de 1 saatlik pencereye tabidir — teklif pencere
             // açıkken gönderilmiş olsa bile kabul, pencere kapandıktan sonra
             // yapılamaz (bkz. src/services/vekaletServisi.ts vekaletKabulEt'in
             // istemci tarafı kontrolü — o CİHAZ SAATİNE dayanır). Burada
             // `existing()` zaten bildirim belgesidir: ek get() maliyeti YOK.
             mazeretPenceresiAcik(existing()) &&
             talep.bildirimId == docId &&
             talep.aliciUid == request.auth.uid &&
             talep.durum == 'kabul_edildi';
    }

    // NOT (ifade tavanı denetimi): `get(muezzinDoc)` tek bir `let`'e alındı —
    // önceden aynı doküman için 3 ayrı `get()` çağrısı vardı (role, aktif,
    // onayBekliyor), üstelik bu fonksiyon `bildirimler` update kuralındaki
    // 4 dalın HER birinden çağrılıyor (bkz. isSelfBildirimUpdate yorumu, aynı
    // dosyada zaten belgeli 1000-ifade tavanı riski). `exists(muezzinDoc)`
    // && ile önce kısa devre yapıyor — CEL `&&` yalnız
    // gerektiğinde sağ tarafı değerlendirdiğinden, doküman yoksa `get()` hiç
    // çalışmıyor. (Eskiden burada `exists(...) ? get(...).data : null`
    // ternary'si vardı; derleyici bunun için zararsız ama gürültülü bir
    // `[W] Invalid type. Received one of [null]. Expected one of [map]`
    // uyarısı basıyordu — `&&` kısa devresi hem uyarıyı kaldırıyor hem de
    // değerlendirilen ifade sayısını bir tık azaltıyor. Davranış aynı:
    // doküman yoksa sonuç yine false.)
    function isAssignableDutyUid(uid) {
      let muezzinDoc = /databases/$(database)/documents/muezzins/$(uid);
      return exists(muezzinDoc) && isAssignableDutyUidVeri(uid, get(muezzinDoc).data);
    }

    // isAssignableDutyUid'in get()'siz hali — çağıran taraf muezzins verisini
    // başka bir sebeple zaten okumuşsa AYNI belgeyi ikinci kez get() etmeden
    // bu fonksiyona doğrudan veriyi geçebilir.
    function isAssignableDutyUidVeri(uid, muezzinVeri) {
      return uid is string &&
             muezzinVeri != null &&
             muezzinVeri.role == 'muezzin' &&
             muezzinVeri.aktif == true &&
             // onayBekliyor: true olan (admin henüz onaylamamış) bir davetli
             // nöbete atanabilir sayılmamalı — AuthGuard ona zaten bir
             // bekleme ekranı gösterdiğinden, atandığı vakit kimse
             // göremiyordu (bkz. mimari denetim Y4).
             muezzinVeri.get('onayBekliyor', false) != true;
    }

    // Bir "YYYY-MM-DD" tarihinin haftanın hangi gününe denk geldiğini
    // haftalikIzinGunu ile AYNI ölçekte (Pazartesi=1 ... Pazar=7) döner.
    // epochGunSayisi mod 7'si 0 olması Perşembe demek (1970-01-01 bir
    // Perşembe, bkz. izinAraligiCumaIceriyorMu yorumu) — bu, Pazartesi
    // tabanlı 1-7 ölçeğine kaydırılır. `kisiGunIcinMusaitMi` (dateUtils.ts)
    // ve planlamaCekirdegi.ts'teki `gunIndex + 1` ile aynı sonucu üretir.
    function haftaGunuNumarasi(tarihStr) {
      let gun = ((epochGunSayisi(tarihStr) % 7) + 7) % 7;
      return ((gun + 3) % 7) + 1;
    }

    function isValidBildirim(data) {
      return data.keys().hasAll(['haftaId', 'tarih', 'vakit', 'uid', 'tip', 'durum', 'pendingAck', 'olusturmaTarihi', 'sonGuncelleme']) &&
             data.keys().hasOnly(['haftaId', 'tarih', 'vakit', 'uid', 'tip', 'durum', 'pendingAck', 'retSebebi', 'olusturmaTarihi', 'sonGuncelleme', 'devirSonucu', 'asilMazeretUid', 'mazeretPlanSenkronEdildi', 'vekaletPlanSenkronEdildi', 'cumaMi', 'vekaletDevredildi', 'vekaletDevriBekliyor', 'puanIslendi', 'manuelAtama', 'mazeretSonBasvuru']) &&
             data.haftaId is string &&
             data.tarih is string && data.tarih.size() == 10 &&
             data.vakit in ['sabah', 'ogle', 'ikindi', 'aksam', 'yatsi'] &&
             isAssignableDutyUid(data.uid) &&
             // Sabit haftalık izin gününde asla atama yok — planlamaCekirdegi.ts
             // (otomatik motor) bunu mutlak sayar, ama admin'in manuel atama
             // yolu (HaftalikCizelge.tsx vakitAtamasiniGuncelle) sunucu
             // tarafında hiç doğrulanmıyordu (bkz. mimari denetim). Onaylı
             // izin KAPSAMI ayrı bir kısıttır ama "bu uid'in bugünü kapsayan
             // onaylı bir izni var mı" sorusu bir koleksiyon sorgusu
             // gerektirir — Security Rules yalnızca bilinen TEK bir doküman
             // yoluna get() yapabilir, sorgu çalıştıramaz; bu yüzden yalnızca
             // muezzins doc'unun kendi haftalikIzinGunu alanı (tek bilinen
             // yoldan get() edilebilir) burada uygulanabiliyor — izin kapsamı
             // istemci tarafı hard-block'a kalıyor.
             !(data.tip in ['asil', 'yedek'] &&
               get(/databases/$(database)/documents/muezzins/$(data.uid)).data.get('haftalikIzinGunu', 0) == haftaGunuNumarasi(data.tarih)) &&
             data.tip in ['asil', 'yedek', 'gorev_cagrisi'] &&
             data.durum in ['bekliyor', 'onaylandi', 'reddedildi', 'sistem_atadi', 'iptal', 'okundu_varsayilan'] &&
             data.pendingAck is bool &&
             // Diğer tüm zaman damgası alanları (isValidVakitCache
             // guncellenmeTarihi, isValidErrorLog/isValidTelemetryLog
             // timestamp) `is timestamp` ile tiplenirken bu ikisi hiç
             // kontrol edilmiyordu — tüm gerçek çağıranlar serverTimestamp()
             // gönderse de bu şema doğrulayıcısını çağıran yollarda (create,
             // admin update) teorik olarak keyfi bir değer kabul ediliyordu
             // (bkz. mimari denetim — üçüncü tur).
             data.olusturmaTarihi is timestamp &&
             data.sonGuncelleme is timestamp &&
             (!data.keys().hasAny(['retSebebi']) || data.retSebebi == null || (data.retSebebi is string && data.retSebebi.size() <= 500)) &&
             // mazeretPlanSenkronEdildi/vekaletPlanSenkronEdildi kasitli olarak
             // AYRI iki alan — ikisi eskiden tek bir paylasilan
             // planSenkronEdildi alanini kullaniyordu, bu da bir bildirim
             // once vekaletle sonra mazeretle (ya da tam tersi) el
             // degistirdiginde ikinci olayin "zaten islenmis" sanilip
             // sessizce atlanmasina yol aciyordu (bkz. mimari denetim Y2).
             (!data.keys().hasAny(['mazeretPlanSenkronEdildi']) || data.mazeretPlanSenkronEdildi is bool) &&
             (!data.keys().hasAny(['vekaletPlanSenkronEdildi']) || data.vekaletPlanSenkronEdildi is bool) &&
             (!data.keys().hasAny(['devirSonucu']) || data.devirSonucu is string) &&
             (!data.keys().hasAny(['asilMazeretUid']) || data.asilMazeretUid is string) &&
             // cumaMi kasitli olarak opsiyonel: eski (bu alan eklenmeden once
             // olusturulmus) belgeler bu alan olmadan da gecerli kalir — bkz.
             // isSelfBildirimUpdate()'teki `!= true` karsilastirmasi.
             (!data.keys().hasAny(['cumaMi']) || data.cumaMi is bool) &&
             (!data.keys().hasAny(['vekaletDevredildi']) || data.vekaletDevredildi is bool) &&
             (!data.keys().hasAny(['vekaletDevriBekliyor']) || data.vekaletDevriBekliyor is bool) &&
             // `puanIslendi`: yalnızca Admin SDK (scripts/yatsiSonuIslemleri.ts,
             // kural bütçesi yok) yazar — bir bildirimin aylık sayaçlara (bkz.
             // gunlukKrediHesaplama.ts) zaten kredilendirildiğini işaretler,
             // script'in aynı gün için tekrar çalıştırılmasında (ör. GitHub
             // Actions manuel "Re-run") çift kredilendirmeyi önler. Client
             // hiçbir zaman bu alanı YAZMIYOR ama `hasOnly` her `update`'te
             // TÜM belgeyi (mevcut + değişen) doğruladığından, bu alan
             // eklenmezse bu alanı taşıyan HER bildirimde sonraki tüm client
             // güncellemeleri (okudum onayla, mazeret, vekalet bayrağı) kalıcı
             // olarak reddedilirdi (bkz. kod denetimi bulgusu).
             (!data.keys().hasAny(['puanIslendi']) || data.puanIslendi is bool) &&
             // manuelAtama: src/services/planServisi.ts vakitAtamasiniGuncelle
             // yazar — bir admin'in elle atadığı bir slotu, kişi henüz
             // onaylamadan/reddetmeden önce (durum hâlâ 'bekliyor') sonraki bir
             // plan yeniden üretiminin ezmesini önler (premium hata analizi
             // PL-K2, bkz. vekaletDevredildi/vekaletDevriBekliyor ile aynı desen).
             (!data.keys().hasAny(['manuelAtama']) || data.manuelAtama is bool) &&
             // mazeretSonBasvuru: mazeret/vekalet penceresinin KAPANDIĞI an
             // (bkz. `mazeretPenceresiAcik`). ŞEMADA opsiyoneldir — bu alanı
             // taşımayan ESKİ belgeler geçerli kalmalı, aksi halde onlara
             // yapılan HER admin update'i (arşivleme, yeniden atama) kalıcı
             // olarak reddedilirdi (bkz. `puanIslendi` yorumundaki aynı sınıf
             // bulgu). Güvenlik kararı ise opsiyonel DEĞİLDİR: alan eksikse
             // `mazeretPenceresiAcik` false döner, yani mazeret/vekalet
             // yazımları fail-closed reddedilir.
             (!data.keys().hasAny(['mazeretSonBasvuru']) || data.mazeretSonBasvuru is timestamp);
    }

    // ifade tavanı denetimi — TAM ÖZET (3 tur):
    // 1. tur: her dalın pahalı gövdesi (getAfter/get) koşulsuz `let`'lerle
    //    fonksiyon girişinde çalışıyordu — cheap-check/expensive-body ayrımı
    //    yapıldı (isSelfBildirimUpdate/Icin deseni).
    // 2. tur: get() paylaşımı ve admin dalını OR zincirinde sona almak —
    //    İKİSİ DE "1000 ifade" uyarı SAYISINI DEĞİŞTİRMEDİ (13 → 13, ölçüldü).
    //    Bu, tavanın çalışma-zamanı okuma/kısa-devre davranışından değil,
    //    kuralın DERLENMİŞ ifade ağacının TOPLAM boyutundan (tüm dalların
    //    birleşik terim sayısı, hangi dalın gerçekte çalıştığından bağımsız)
    //    kaynaklandığını kanıtladı — en basit tek-alan self-update yazımı
    //    bile tavana çarpıyordu.
    // 3. tur (KÖK NEDEN ÇÖZÜMÜ): vekalet-kabul TRANSFERİ ve mazeret-reddi
    //    sonrası yedek-terfi — kuralın en pahalı 2 dalı (~72 terim, 2
    //    getAfter() çağrısı) — CEL'den tamamen çıkarılıp Admin SDK ile
    //    çalışan scripts/vekaletDevirleriniIsle.ts / mazeretDevirleriniIsle.ts
    //    içine taşındı (kural bütçesi yok, düz TypeScript, taze veriyle
    //    yeniden doğrulama). İstemci artık yalnızca dar "niyet" bayrakları
    //    yazıyor. Kalan 3 dal (self-update, vekalet-bayrağı, admin) toplamda
    //    eskisinin küçük bir kesri kadar terim içeriyor — bu kez ölçülebilir,
    //    yapısal bir azalma (bkz. npm run test:rules çıktısı).
    match /bildirimler/{docId} {
      allow read, list: if isSignedIn();
      allow create: if isAdmin() && isValidBildirim(incoming());
      allow update: if isSignedIn() && (
        isSelfBildirimUpdate(docId) ||
        isVekaletDevriBekliyorIsareti(docId) ||
        (isAdmin() && isValidBildirim(incoming()))
      );
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------
    // ENTITY: Mazeret Detayları
    // ---------------------------------------------------------
    // bildirimler.retSebebi (özel mazeret/ret gerekçesi metni) buradan
    // taşındı (bkz. isSelfBildirimUpdate yorumu, mimari denetim — altıncı
    // tur) — Firestore alan bazında değil BELGE bazında güvenlik
    // sağladığından, bildirimler `allow read: if isSignedIn()` ile (haftalık
    // çizelgeyi TÜM ekibin görebilmesi için GEREKLİ) açık kalmak zorundaydı,
    // bu da retSebebi'yi de istemeden herkese açıyordu. Bu koleksiyon
    // yalnızca ilgili kişi + admin tarafından okunabilir; doc ID karşılık
    // geldiği bildirimler belgesiyle AYNI deterministik ID'yi kullanır
    // (haftaId_tarih_vakit_tip) — src/services/mazeretServisi.ts'in zaten
    // sahip olduğu bildirimId parametresi doğrudan kullanılır.
    function isValidMazeretDetay(data) {
      return data.keys().hasAll(['uid', 'retSebebi', 'olusturmaTarihi']) &&
             data.keys().hasOnly(['uid', 'retSebebi', 'olusturmaTarihi']) &&
             data.uid is string &&
             data.retSebebi is string && data.retSebebi.size() > 0 && data.retSebebi.size() <= 500 &&
             data.olusturmaTarihi is timestamp;
    }

    match /mazeret_detaylari/{bildirimId} {
      // `resource == null` dali: admin olmayan bir kullanici var olmayan bir
      // mazeret_detaylari ID'sine getDoc atarsa `resource` null olur;
      // eskiden `resource.data.uid` null-deref hatasiyla reddediliyordu
      // (bkz. vekalet_talepleri/izinler get kurallarindaki ayni sinif bug,
      // e2e denetimi — bu koleksiyonda henuz gercek bir non-admin cagiran
      // yok ama desen tutarliligi ve savunma derinligi icin duzeltildi).
      // `resource == null` dali `isSignedIn()` KAPSAMINDA olmali (bkz.
      // `izinler` get kuralindaki ayni yapi): disarida kaldiginda GIRIS
      // YAPMAMIS bir cagiran icin `isAdmin()` false donup dogrudan bu dala
      // dusuyordu — belge YOKSA get basarili, VARSA reddedilmis oluyordu.
      // Doc ID tamamen deterministik (haftaId_tarih_vakit_tip, bkz.
      // yukaridaki yorum ve src/services/mazeretServisi.ts) oldugundan bu,
      // kimlik dogrulamasi olmadan "hangi nobet icin mazeret bildirilmis"
      // bilgisini tek tek deneyerek cikarmaya izin veren bir VARLIK ORAKULU
      // idi (bkz. kod denetimi).
      allow get: if isAdmin() || (isSignedIn() && (resource == null || resource.data.uid == request.auth.uid));
      allow list: if isAdmin();
      // `incoming().uid == request.auth.uid` tek başına yalnızca YAZANIN
      // kim olduğunu doğruluyordu, HANGİ bildirime yazdığını değil — doc ID
      // (bildirimId) karşılık gelen bildirimler belgesiyle AYNI
      // deterministik ID'yi kullandığından (bkz. yukarıdaki yorum), giriş
      // yapmış HERHANGİ bir kullanıcı bir meslektaşının henüz mazeret
      // bildirmediği bir nöbetin ID'sini önceden `create` ile "işgal"
      // edebiliyordu — belge var olduktan sonra `update` daima `if false`
      // olduğundan, gerçek sahip aynı ID'ye ATOMİK batch'iyle (bkz.
      // mazeretServisi.ts mazeretRetBatch) yazmaya çalıştığında bu bir
      // update sayılır ve kalıcı olarak reddedilir (bkz. kod denetimi
      // güvenlik bulgusu). `bildirimId`'nin GERÇEKTEN yazan kişiye ait
      // olduğunu (bildirimler belgesindeki uid ile) doğrulamak bu işgali
      // engeller.
      allow create: if isSignedIn() && isValidMazeretDetay(incoming()) && incoming().uid == request.auth.uid &&
        get(/databases/$(database)/documents/bildirimler/$(bildirimId)).data.uid == request.auth.uid;
      // Sabit kayıt — mazeret bir kez bildirilir, normalde değişmez. TEK
      // istisna: admin ilgili bildirimi tekrar 'bekliyor'a açtıysa (bkz.
      // isValidBildirim admin dalı — bu geçişte durum kısıtı yok), aynı
      // kişi aynı deterministik ID'ye (haftaId_tarih_vakit_tip) tekrar
      // mazeret bildirmek isteyebilir; bu artık bir `update`tir (belge zaten
      // var) ve `if false` altında KALICI OLARAK reddedilirdi — kullanıcı o
      // nöbet için bir daha asla mazeret bildiremezdi (premium hata analizi
      // FR-O8). Yalnızca bildirim GERÇEKTEN yeniden 'bekliyor' durumundaysa
      // ve yazan hâlâ aynı (asıl) sahipse izin verilir.
      allow update: if isSignedIn() && isValidMazeretDetay(incoming()) &&
        incoming().uid == request.auth.uid && existing().uid == request.auth.uid &&
        get(/databases/$(database)/documents/bildirimler/$(bildirimId)).data.uid == request.auth.uid &&
        get(/databases/$(database)/documents/bildirimler/$(bildirimId)).data.durum == 'bekliyor';
      allow delete: if false;
    }

    // ---------------------------------------------------------
    // ENTITY: Vekalet Talepleri
    // ---------------------------------------------------------
    match /vekalet_talepleri/{talepId} {
      // `resource == null` dalı şart: vekaletTeklifEt henüz var olmayan bir
      // talep ID'sine (ilk teklif) `getDoc` ile önceden reddedilmiş bir kaydı
      // temizlemek için bakar (bkz. vekaletServisi.ts). Belge yoksa `resource`
      // null olur; eskiden `isVekaletParticipant(existing())` bu durumda
      // `null.gonderenUid` erişimiyle hata fırlatıp isteği reddediyordu —
      // admin olmayan HİÇBİR kullanıcı ilk kez teklif gönderemiyordu (bu
      // sadece bir emülatör kusuru değil: PRODUCTION'da da `isAdmin()` false
      // dönüp `existing()` null-deref hatasıyla sonuçlanınca istek reddedilir
      // — talep henüz yokken varlığını kontrol etmek dahi engelleniyordu).
      // Bir talebin YOK OLMASI hassas bilgi değil (`izinler` L783'teki aynı
      // `resource == null` deseniyle simetrik) — bu yüzden yok-belge durumu
      // koşulsuz izinli, yalnızca VAR OLAN bir talep katılımcı kısıtına tabi.
      allow get: if isAdmin() || resource == null || isVekaletParticipant(existing());
      allow list: if isAdmin() || isVekaletParticipant(existing());
      allow create: if isSignedIn() && isValidVekaletCreate(talepId);
      // ADMIN DALI ŞEMA DOĞRULAMASI (kod denetimi — "script talep/bildirim
      // alanlarını karıştırıyor" bulgusunun KÖK NEDENİ): bu dal eskiden
      // KOŞULSUZ `isAdmin()` idi — hiçbir şema/alan kısıtı yoktu. Talep ve ona
      // bağlı bildirim belgesi OLUŞTURMA anında `isValidVekaletCreate` ile
      // birebir eşitleniyor (`bildirim.tarih == incoming().tarih` vb.), ama
      // oluşturmadan SONRA bir admin yazımı bu eşitliği bozabiliyordu; o
      // noktadan itibaren scripts/vekaletDevirleriniIsle.ts'in bazı kontrolleri
      // (Cuma, izin günü) `bildirim.*`, bazıları (ezan geçmiş mi) `talep.*`
      // okuduğu için FARKLI görevler hakkında karar veriyordu. Script tarafı
      // artık tek kaynağa (`bildirim.*`) çekildi VE talep<->bildirim
      // korelasyonunu ayrıca doğruluyor; burası ise sorunu kaynağında keser:
      // admin bir talebin KİMLİK/KORELASYON alanlarını (hangi bildirime, hangi
      // gün/vakit/tip'e, kimler arasında) hiçbir zaman değiştiremez. Meşru
      // admin işlemleri daralmaz: bugün admin arayüzünde `vekalet_talepleri`'ne
      // YAZAN hiçbir yol yok (yalnızca okuma hook'ları ve
      // veriSifirlamaServisi'nin toplu SİLME'si — o `allow delete` altında);
      // ileride bir onarım gerekirse `durum`/`sonGuncelleme` ve görüntülenen
      // isim/saat alanları hâlâ düzenlenebilir kalır.
      allow update: if (isAdmin() && isAdminVekaletUpdate()) || isRecipientVekaletStatusUpdate();
      // 'reddedildi' de silinebilir olmalı: talep ID'si deterministik
      // (haftaId_tarih_vakit_tip_aliciUid) olduğundan, reddedilen bir talep
      // silinmeden aynı kişiye bir daha teklif gönderilemiyordu — setDoc bu
      // durumda create değil update sayılır ve isValidVekaletCreate/
      // isRecipientVekaletStatusUpdate hiçbiri eşleşmediği için kalıcı
      // kilitleniyordu (bkz. mimari denetim O7).
      allow delete: if isAdmin() || (isSignedIn() && existing().gonderenUid == request.auth.uid && existing().durum in ['beklemede', 'reddedildi']);
    }

    // ---------------------------------------------------------
    // ENTITY: Admin Uyarilari
    // ---------------------------------------------------------
    match /adminUyarilari/{docId} {
      // Admin her belgeyi görür/yazar. Oturum açmış müezzinler ise yalnızca
      // ÇÖZÜLMEMİŞ uyarıları görebilir (bkz. tasarım denetimi: saha müezzini
      // sistem arızasından tamamen habersiz kalıyordu) — çözüm notları ve
      // geçmiş kayıtlar admin'e özel kalır.
      allow read: if isAdmin() || (isSignedIn() && existing().cozuldu == false);
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------
    // ENTITY: Sistem Günlükleri ve Hata Raporları
    // ---------------------------------------------------------
    // Alan/boyut sınırları, tek bir bozuk/kötü niyetli istemcinin sınırsız
    // büyüyen belgelerle günlük Firestore yazma kotasını (Spark plan) veya
    // 1 GB depolama sınırını tüketmesini engeller.
    function isValidErrorLog(data) {
      return data.keys().hasAll(['errorMessage', 'errorStack', 'componentStack', 'userId', 'device', 'breadcrumbs', 'stateSnapshot', 'timestamp']) &&
             // hasOnly eksikti — istemci bilinen alanların yanına keyfi
             // isimde/sayıda ek alan ekleyebiliyordu (premium hata analizi
             // FR-O2).
             data.keys().hasOnly(['errorMessage', 'errorStack', 'componentStack', 'userId', 'device', 'breadcrumbs', 'stateSnapshot', 'timestamp']) &&
             data.userId == request.auth.uid &&
             data.errorMessage is string && data.errorMessage.size() <= 2000 &&
             data.errorStack is string && data.errorStack.size() <= 8000 &&
             data.componentStack is string && data.componentStack.size() <= 8000 &&
             data.device is map &&
             data.breadcrumbs is list && data.breadcrumbs.size() <= 30 &&
             data.stateSnapshot is map &&
             data.timestamp is timestamp;
    }

    // `write` (create+update+delete) eskiden tek satırda `isAdmin()`e açıktı —
    // yani SistemHatalariSekmesi.tsx'in "TEMİZLE" düğmesi ve
    // veriSifirlamaServisi.ts'in toplu silmesi sıradan bir admin tarafından da
    // yürütülebiliyordu (bkz. premium denetim P1.6). Bu koleksiyon SALT
    // BİRİKTİRME amaçlı: normal bir admin iş akışında hiçbir belgesi
    // güncellenmez, yalnızca okunur — bu yüzden update/delete'i süper-admin'e
    // daraltmak hiçbir meşru akışı kırmaz. Retention temizliği zaten Admin SDK
    // ile (scripts/temizleGunlukler.ts, kurallar ATLANIR) yapılıyor.
    match /error_logs/{docId} {
      allow create: if isSignedIn() && isValidErrorLog(incoming());
      allow read: if isAdmin();
      allow update, delete: if isSuperAdmin();
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['actionType', 'targetName', 'details', 'userId', 'userDisplayName', 'timestamp']) &&
             data.keys().hasOnly(['actionType', 'targetName', 'details', 'userId', 'userDisplayName', 'timestamp']) &&
             data.actionType is string && data.actionType.size() > 0 && data.actionType.size() <= 80 &&
             data.targetName is string && data.targetName.size() > 0 && data.targetName.size() <= 160 &&
             data.details is string && data.details.size() > 0 && data.details.size() <= 500 &&
             data.userId == request.auth.uid &&
             data.userDisplayName is string && data.userDisplayName.size() > 0 && data.userDisplayName.size() <= 120 &&
             // timestamp tipi hiç doğrulanmıyordu — diğer tüm zaman damgası
             // alanlarının (isValidVakitCache, isValidErrorLog/
             // isValidTelemetryLog) aksine bu değişmez denetim kaydına
             // keyfi (string/number) bir değer yazılabiliyordu (premium hata
             // analizi FR-O1).
             data.timestamp is timestamp;
    }

    match /audit_logs/{docId} {
      allow get, list: if isAdmin();
      allow create: if isSignedIn() && isValidAuditLog(incoming());
      allow update, delete: if false;
    }

    function isValidTelemetryLog(data) {
      return data.keys().hasAll(['eventType', 'eventName', 'userId', 'metadata', 'timestamp']) &&
             // hasOnly eksikti (bkz. isValidErrorLog, FR-O2 ile aynı gerekçe).
             data.keys().hasOnly(['eventType', 'eventName', 'userId', 'metadata', 'timestamp']) &&
             data.userId == request.auth.uid &&
             data.eventType in ['page_view', 'click', 'error', 'performance'] &&
             data.eventName is string && data.eventName.size() <= 200 &&
             data.metadata is map &&
             data.timestamp is timestamp;
    }

    // error_logs ile AYNI gerekçe (bkz. yukarıdaki yorum, premium denetim
    // P1.6): salt-biriktirme koleksiyonu, meşru admin akışında yalnızca
    // okunur; toplu silme süper-admin'e daraltıldı.
    match /telemetry_logs/{docId} {
      allow create: if isSignedIn() && isValidTelemetryLog(incoming());
      allow read: if isAdmin();
      allow update, delete: if isSuperAdmin();
    }

    // ---------------------------------------------------------
    // ENTITY: Config & Settings
    // ---------------------------------------------------------
    match /config/{docId} {
      allow read: if isSignedIn();
      // config/bootstrap superAdminEmails listesini tutar. isAdmin() burada
      // KULLANILAMAZ: isAdmin() siradan role=='admin' kullanicilarini da
      // kapsadigindan, yazima izin verilirse herhangi bir admin kendini
      // listeye ekleyip kalici bir super-admin arka kapisi acabilir, hatta
      // gercek super-adminleri listeden cikarabilir (bkz. mimari denetim K2).
      // Bu belge yalnizca admin SDK ile (scripts/seedSuperAdminConfig.ts)
      // yazilir; SDK guvenlik kurallarini atladigi icin bu kisitlama onu
      // etkilemez.
      allow write: if false;
    }

    function isValidSystemSettings(data) {
      return data.keys().hasAll(['ilceId', 'ilceAdi', 'hicriDuzeltme']) &&
             data.keys().hasOnly(['ilceId', 'ilceAdi', 'hicriDuzeltme']) &&
             data.ilceId is string && data.ilceId.size() >= 3 && data.ilceId.size() <= 8 &&
             data.ilceId.matches('^[0-9]+$') &&
             data.ilceAdi is string && data.ilceAdi.size() >= 2 && data.ilceAdi.size() <= 80 &&
             data.hicriDuzeltme is int &&
             data.hicriDuzeltme >= -2 &&
             data.hicriDuzeltme <= 2;
    }

    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && docId == 'system' && isValidSystemSettings(incoming());
    }

    // ---------------------------------------------------------
    // ENTITY: Izinler
    // ---------------------------------------------------------
    // İzin (leave) tarih aralığının bir Cuma içerip içermediğini saf tarih
    // aritmetiğiyle hesaplar. Bu kısıtlamanın istemci tarafı karşılığı
    // (VacationRequestCard.tsx'teki `hasFriday` döngüsü) daha önce SUNUCU
    // tarafında hiç doğrulanmıyordu — bildirimler/vekalet_talepleri'ndeki
    // Cuma kısıtlamasının aksine (bkz. cumaMiIsaretli), izin oluşturma
    // isteğini gönderen taraf ile kısıtlamadan kaçınmak isteyen taraf AYNI
    // kişi olduğundan, bildirimler'deki gibi istemcinin hesapladığı bir
    // bayrağa (`cumaMi` benzeri) güvenmek gerçek bir doğrulama olmazdı — o
    // bayrağı DevTools'tan trivially `false` göndererek kısıtlama tamamen
    // atlatılabilirdi.
    //
    // Firestore Rules'ta ne döngü ne de bir `timestamp(string)` ayrıştırıcısı
    // var (denendi, emülatörde "Function not found" ile reddedildi) — bu
    // yüzden "YYYY-MM-DD" güne, Howard Hinnant'ın bilinen "days_from_civil"
    // takvim formülüyle (yalnızca +,-,*,/ operatörleri) saf tamsayı
    // aritmetiğiyle epoch-gün sayısına çevrilir. 1970-01-01 bir Perşembe
    // olduğundan epoch-gün sayısının mod 7'si 1 olması o günün Cuma
    // olduğu anlamına gelir; aralığın başlangıcından bir sonraki Cuma'ya
    // kalan gün sayısı aralık uzunluğunu aşmıyorsa aralık bir Cuma içerir.
    function epochGunSayisi(tarihStr) {
      let parcalar = tarihStr.split('-');
      let y0 = int(parcalar[0]);
      let m0 = int(parcalar[1]);
      let d0 = int(parcalar[2]);
      // Şubat'ı yılın son ayı sayan takvim kaydırması (Hinnant formülü) —
      // gerçekçi tarihler (y0 > 0) için era/yoe hep pozitif kalır.
      let y = y0 - (m0 <= 2 ? 1 : 0);
      let era = y / 400;
      let yoe = y - era * 400;
      let mAdj = m0 + (m0 > 2 ? -3 : 9);
      let doy = (153 * mAdj + 2) / 5 + d0 - 1;
      let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
      return era * 146097 + doe - 719468;
    }

    function izinAraligiCumaIceriyorMu(baslangic, bitis) {
      let startDay = epochGunSayisi(baslangic);
      let endDay = epochGunSayisi(bitis);
      let rangeDays = endDay - startDay;
      let gunlerCumayaKadar = (1 - (startDay % 7) + 7) % 7;
      return rangeDays >= 0 && gunlerCumayaKadar <= rangeDays;
    }

    // Tarih-aralığı şekil/iş-kuralı doğrulamasını `isValidIzin`'den ayrı bir
    // fonksiyona çıkarır — `isValidIzin`'in uid/durum sabitleri (kendi
    // isteğini oluşturan/düzenleyen kullanıcıya özgü) admin onarım yoluna
    // (bkz. `izinler` update kuralı, admin disjunct'ı) uygulanamaz; admin
    // veriOnarimServisi.ts üzerinden BAŞKASININ ters-tarihli izin kaydını
    // düzeltirken ne kendi uid'i eşleşir ne kayıt 'onay_bekliyor' durumunda
    // olmak zorundadır (bkz. mimari denetim — üçüncü tur).
    function isValidIzinTarihAraligi(baslangic, bitis) {
      return baslangic is string && baslangic.size() == 10 &&
             bitis is string && bitis.size() == 10 &&
             // Ters çevrilmiş aralık (bitis < baslangic) mantıksız veri —
             // planlamaCekirdegi.ts'in string karşılaştırmasında zararsız
             // kalsa da (hiçbir güne eşleşmez) sunucu tarafında reddedilmesi
             // daha temiz.
             bitis >= baslangic &&
             !izinAraligiCumaIceriyorMu(baslangic, bitis);
    }

    function isValidIzin(data) {
      return data.keys().hasAll(['uid', 'baslangic', 'bitis', 'tip', 'durum', 'olusturmaTarihi']) &&
             // Diğer tüm şema doğrulayıcıları (isValidMuezzin, isValidBildirim,
             // isValidVekaletTalebi vb.) alan setini hasOnly ile sınırlıyor —
             // isValidIzin bunu atlıyordu, VacationRequestCard.tsx'in
             // gönderdiği `sebep` dahil herhangi bir ekstra/sınırsız-uzunlukta
             // alan sessizce kabul ediliyordu (bkz. mimari denetim — üçüncü
             // tur). `redSebebi` opsiyonel (admin red gerekçesi) ama izinler
             // update kuralının self-update dalı isValidIzin'i çağırdığından
             // burada da izinli olmalı.
             //
             // `sebep` ARTIK BURADA DEĞİL — `izin_detaylari` koleksiyonuna
             // taşındı (bkz. altta `isValidIzinDetay`). Sebep: `izinler`'in
             // `list` kuralı, TÜM EKİBİN "kimin onaylı izni var" görebilmesi
             // için `durum=='onaylandi'` belgelerini herkese açar — bu da
             // (retSebebi'nin bildirimler'den mazeret_detaylari'na
             // taşınmasına yol açan bulguyla BİREBİR AYNI sınıf) izin
             // gerekçesini (sağlık, ailevi durum vb.) istemeden tüm ekibe
             // açıyordu; Firestore alan bazında değil BELGE bazında güvenlik
             // sağladığından bu, `izinler` açık kaldığı sürece kapatılamazdı
             // (premium hata analizi FR-O3).
             //
             // `bildirimGonderildi` / `bildirimGonderimBaslangici`: yalnızca
             // Admin SDK (scripts/izinDurumBildirimGonder.ts — bu kural ATLANIR)
             // ve izinGuncelle/izinGeriAl yazar. `puanIslendi`'nin
             // isValidBildirim'de yol açtığı bulgunun BİREBİR AYNISI burada da
             // vardı: `hasOnly` her update'te TÜM belgeyi doğruladığından, bu
             // alanları taşıyan bir izin belgesi 'onay_bekliyor' durumuna geri
             // dönerse (cron `bildirimGonderildi: true` yazarken adminin
             // izinGeriAl'i araya girerse — izinGeriAl bayrağı silse de bu
             // yarış penceresi gerçektir) sahibinin kendi bekleyen talebini
             // düzenlediği self-update dalı (aşağıdaki `izinler` update
             // kuralı) KALICI olarak reddedilirdi. İkisi de tipli ve
             // opsiyonel olarak listelenir.
             data.keys().hasOnly(['uid', 'baslangic', 'bitis', 'tip', 'durum', 'olusturmaTarihi', 'redSebebi', 'bildirimGonderildi', 'bildirimGonderimBaslangici']) &&
             (!data.keys().hasAny(['bildirimGonderildi']) || data.bildirimGonderildi is bool) &&
             (!data.keys().hasAny(['bildirimGonderimBaslangici']) || data.bildirimGonderimBaslangici is timestamp) &&
             data.uid == request.auth.uid &&
             // İzin (leave) yalnızca nöbete atanabilen 'muezzin' rolü icin
             // anlamlidir — admin ve gozlemci hicbir zaman nobete
             // atanmiyor (bkz. isAssignableDutyUidVeri, role == 'muezzin'
             // sarti), yani onlar icin bir izin kaydinin planlama acisindan
             // hicbir karsiligi yok. Istemci (VacationRequestCard.tsx) bu
             // forma role bakmaksizin herkesi eristiriyordu — sunucu
             // tarafinda hic dogrulanmiyordu (bkz. yetki denetimi).
             get(/databases/$(database)/documents/muezzins/$(request.auth.uid)).data.role == 'muezzin' &&
             data.tip in ['haftalik', 'yillik', 'mazeret'] &&
             data.durum == 'onay_bekliyor' &&
             isValidIzinTarihAraligi(data.baslangic, data.bitis);
    }

    // izinler'den taşınan `sebep` alanı için — bkz. yukarıdaki isValidIzin
    // yorumu ve `mazeret_detaylari` (retSebebi) ile AYNI desen. Doc ID
    // karşılık geldiği izinler belgesiyle AYNI ID'yi kullanır.
    function isValidIzinDetay(data) {
      return data.keys().hasAll(['uid', 'sebep', 'olusturmaTarihi']) &&
             data.keys().hasOnly(['uid', 'sebep', 'olusturmaTarihi']) &&
             data.uid is string &&
             data.sebep is string && data.sebep.size() <= 1000 &&
             data.olusturmaTarihi is timestamp;
    }

    match /izin_detaylari/{izinId} {
      allow get: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow list: if isAdmin();
      // mazeret_detaylari'nin aksine karşılık gelen `izinler` belgesinin
      // uid'ini get() ile ÇAPRAZ DOĞRULAMAZ — o kontrol orada
      // DETERMİNİSTİK (haftaId_tarih_vakit_tip, tahmin edilebilir) ID'lere
      // karşı "işgal" saldırısını engellemek içindi. Buradaki ID Firestore
      // otomatik-üretilen (uzun, rastgele) bir ID'dir; ayrıca istemci
      // (VacationRequestCard.tsx) izinler+izin_detaylari'yi TEK bir atomik
      // batch'te birlikte oluşturur — get() içindeki bir batch KENDİ
      // KARDEŞ işlemini göremediğinden (ölçüldü: aynı batch'te önce
      // izinler create'i yapılsa bile get() burada "yok" görür ve tüm
      // batch reddedilir) çapraz doğrulama bu akışta kullanılamaz.
      allow create: if isSignedIn() && isValidIzinDetay(incoming()) && incoming().uid == request.auth.uid;
      // Sahibi kendi kaydını silebilir (izinler'deki karşılık gelen
      // belgeyi iptal ederken AYNI batch'te) — admin her zaman silebilir.
      allow delete: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow update: if false;
    }

    match /izinler/{docId} {
      // `list` sorgusu yalnizca VAR OLAN belgeler uzerinde degerlendirilir —
      // Firestore bir liste sonucunda "olmayan bir belge" doner remez, bu
      // yuzden `resource` burada asla null olamaz (bu, tek bir bilinen
      // dokuman yoluna get() yapan `get` kuralindan farkli — orada gercekten
      // olmayan bir ID'ye bakilabilir, bkz. asagidaki `get`). Eskiden buraya
      // `get` kuraliyla simetri icin `resource == null` eklenmisti; olu kod
      // oldugu icin kaldirildi (bkz. yetki denetimi) — npm run test:rules
      // ile davranis degismedigi dogrulandi.
      allow list: if isAdmin() || (isSignedIn() && (resource.data.durum == 'onaylandi' || resource.data.uid == request.auth.uid));
      // isSignedIn() ortadaki disjunktta da zorunlu — eskiden yalnizca
      // 'onaylandi' durumu kontrol ediliyordu, yani giris yapmamis biri
      // durumu 'onaylandi' olan HERHANGI bir izin belgesini ID'sini
      // bilerek okuyabiliyordu (bkz. mimari denetim O10).
      // `resource == null` dali `get` icin gercekten gerekli: admin olmayan
      // bir kullanici var olmayan bir izin ID'sine getDoc attiginda
      // `resource` null oldugundan `resource.data.durum` null-deref
      // hatasiyla reddediliyordu (bkz. vekalet_talepleri get kuralindaki
      // ayni sinif bug, e2e denetimi — bu koleksiyonda henuz gercek bir
      // cagiran yok ama desen tutarliligi ve savunma derinligi icin
      // duzeltildi).
      allow get: if isAdmin() || (isSignedIn() && (resource == null || resource.data.durum == 'onaylandi' || resource.data.uid == request.auth.uid));
      allow create: if isSignedIn() && isValidIzin(incoming());
      // Admin disjunct'ı önceden yalnızca durum/redSebebi'ye izin veriyordu —
      // src/services/veriOnarimServisi.ts'in ters-tarihli bir izin kaydını
      // düzeltmek için yazdığı baslangic/bitis alanları bu kapsama hiç
      // girmiyordu, yani "Veri Sağlığı" ekranındaki bu onarım her zaman
      // PERMISSION_DENIED ile başarısız oluyordu (bkz. mimari denetim —
      // üçüncü tur). baslangic/bitis'e dokunulduğunda isValidIzinTarihAraligi
      // ile şekil/iş-kuralı korunuyor; dokunulmadığında (yalnızca durum/
      // redSebebi kararı) eskisi gibi serbest.
      allow update: if (isAdmin() &&
                        // bildirimGonderildi: izinGuncelle karar anında
                        // `false` yazar, izinGeriAl kararı geri alırken
                        // siler — scripts/izinDurumBildirimGonder.ts (Admin
                        // SDK, bu kural ATLANIR) push gönderdikten sonra
                        // `true`'ya çevirir (bkz. useAdminIzinlerStore.ts).
                        incoming().diff(existing()).affectedKeys().hasOnly(['durum', 'redSebebi', 'baslangic', 'bitis', 'bildirimGonderildi']) &&
                        (!incoming().diff(existing()).affectedKeys().hasAny(['baslangic', 'bitis']) ||
                         isValidIzinTarihAraligi(incoming().baslangic, incoming().bitis)) &&
                        // `durum` değeri önceden hiç doğrulanmıyordu — admin
                        // dalı yalnızca hangi ALANLARIN değiştiğine bakıyordu,
                        // DEĞERİNE değil; geçersiz bir durum değeri sessizce
                        // kabul edilip izinDurumBildirimGonder.ts'in eşleşen
                        // hiçbir dalına girmeden yutuluyordu (düşük öncelikli
                        // bulgu).
                        (!incoming().diff(existing()).affectedKeys().hasAny(['durum']) ||
                         incoming().durum in ['onay_bekliyor', 'onaylandi', 'reddedildi'])) ||
                    (isSignedIn() && existing().uid == request.auth.uid && existing().durum == 'onay_bekliyor' && isValidIzin(incoming()));
      allow delete: if isAdmin() || (isSignedIn() && existing().uid == request.auth.uid && existing().durum == 'onay_bekliyor');
    }

    // Default Deny - MUST BE LAST
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
