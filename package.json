{
  "name": "muezzin-dizge-pro",
  "private": true,
  "version": "2.2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "husky || true",
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.ts\" \"tests/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.ts\" \"tests/**/*.{ts,tsx}\"",
    "test": "npm run test:smoke",
    "test:all": "npm run typecheck && npm run typecheck:scripts && npm run lint && npm run format:check && npm run test:smoke && npm run test:unit && npm run test:rules && npm run test:integration && npm run verify:sw-config && npm run verify:indexes",
    "verify:sw-config": "tsx scripts/verify-sw-config.ts",
    "test:e2e": "playwright test",
    "test:rules": "firebase emulators:exec --only firestore \"tsx scripts/firestore-rules-tests.ts\"",
    "test:integration": "firebase emulators:exec --only firestore \"tsx tests/integration/mazeretDevirleriniIsle.test.ts && tsx tests/integration/vekaletDevirleriniIsle.test.ts && tsx tests/integration/mazeretPenceresiBackfill.test.ts && tsx tests/integration/duyuruBildirimGonder.test.ts && tsx tests/integration/izinDurumBildirimGonder.test.ts && tsx tests/integration/fcmGonderimBasarisizligi.test.ts && tsx tests/integration/fixInvalidRoleAssignments.test.ts && tsx tests/integration/reportWorkflowStatus.test.ts\"",
    "test:smoke": "tsx scripts/smoke-tests.ts",
    "test:unit": "vitest run --coverage",
    "test:unit:watch": "vitest",
    "verify:indexes": "tsx scripts/verify-firestore-indexes.ts",
    "process:mazeret-devirleri": "tsx scripts/mazeretDevirleriniIsle.ts",
    "process:vekalet-devirleri": "tsx scripts/vekaletDevirleriniIsle.ts",
    "process:mazeret-penceresi": "tsx scripts/mazeretPenceresiBackfill.ts",
    "process:duyuru-bildirimi": "tsx scripts/duyuruBildirimGonder.ts",
    "process:izin-durum-bildirimi": "tsx scripts/izinDurumBildirimGonder.ts",
    "seed:super-admin": "tsx scripts/seedSuperAdminConfig.ts",
    "temizle:gunlukler": "tsx scripts/temizleGunlukler.ts",
    "kota:kontrol": "tsx scripts/kotaKontrol.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource/instrument-serif": "^5.2.8",
    "date-fns": "^4.1.0",
    "firebase": "^12.12.0",
    "lucide-react": "^1.37.0",
    "motion": "^13.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-error-boundary": "^6.1.1",
    "react-router-dom": "^7.14.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.2.3",
    "eslint": "^10.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-admin": "^14.1.0",
    "firebase-tools": "^15.23.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.63.0",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  }
}
