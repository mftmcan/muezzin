{
  "name": "muezzin-dizge-pro",
  "private": true,
  "version": "2.2.1",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "husky || true",
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.ts\" \"tests/**/*.{ts,tsx}\" \".github/**/*.{yml,yaml}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.ts\" \"tests/**/*.{ts,tsx}\" \".github/**/*.{yml,yaml}\"",
    "test": "npm run test:smoke",
    "test:all": "npm run typecheck && npm run typecheck:scripts && npm run lint && npm run format:check && npm run verify:ci-workflows && npm run security:audit && npm run test:smoke && npm run test:unit && npm run verify:schema-parity && npm run verify:backup && npm run test:rules && npm run test:integration && npm run test:a11y && npm run verify:sw-config && npm run verify:indexes && npm run build && npm run verify:performance",
    "verify:sw-config": "tsx scripts/verify-sw-config.ts",
    "verify:schema-parity": "tsx scripts/verify-schema-parity.ts",
    "verify:backup": "tsx scripts/verify-backup-coverage.ts",
    "verify:performance": "tsx scripts/verify-performance-budget.ts",
    "verify:ci-workflows": "tsx scripts/verify-ci-workflows.ts",
    "test:e2e": "playwright test",
    "test:a11y": "firebase emulators:exec --only firestore,auth \"playwright test tests/e2e/a11y.spec.ts\"",
    "test:e2e:fonksiyonel": "firebase emulators:exec --only firestore,auth \"playwright test --grep-invert @gorsel\"",
    "test:visual": "firebase emulators:exec --only firestore,auth \"playwright test --grep @gorsel\"",
    "test:rules": "firebase emulators:exec --only firestore \"tsx scripts/firestore-rules-tests.ts\"",
    "test:integration": "firebase emulators:exec --only firestore \"tsx tests/integration/mazeretDevirleriniIsle.test.ts && tsx tests/integration/vekaletDevirleriniIsle.test.ts && tsx tests/integration/mazeretPenceresiBackfill.test.ts && tsx tests/integration/duyuruBildirimGonder.test.ts && tsx tests/integration/izinDurumBildirimGonder.test.ts && tsx tests/integration/fcmGonderimBasarisizligi.test.ts && tsx tests/integration/fixInvalidRoleAssignments.test.ts && tsx tests/integration/reportWorkflowStatus.test.ts && tsx tests/integration/kritikUyariBildirimGonder.test.ts && tsx tests/integration/hataEsigiKontrol.test.ts && tsx tests/integration/firestoreYedekGeriYukle.test.ts\"",
    "test:smoke": "tsx scripts/smoke-tests.ts",
    "test:unit": "vitest run --coverage",
    "test:unit:watch": "vitest",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "verify:indexes": "tsx scripts/verify-firestore-indexes.ts",
    "process:mazeret-devirleri": "tsx scripts/mazeretDevirleriniIsle.ts",
    "process:vekalet-devirleri": "tsx scripts/vekaletDevirleriniIsle.ts",
    "process:mazeret-penceresi": "tsx scripts/mazeretPenceresiBackfill.ts",
    "process:duyuru-bildirimi": "tsx scripts/duyuruBildirimGonder.ts",
    "process:izin-durum-bildirimi": "tsx scripts/izinDurumBildirimGonder.ts",
    "process:kritik-uyari-bildirimi": "tsx scripts/kritikUyariBildirimGonder.ts",
    "seed:super-admin": "tsx scripts/seedSuperAdminConfig.ts",
    "temizle:gunlukler": "tsx scripts/temizleGunlukler.ts",
    "kota:kontrol": "tsx scripts/kotaKontrol.ts",
    "hata:esigi-kontrol": "tsx scripts/hataEsigiKontrol.ts",
    "yedek:al": "tsx scripts/firestoreYedekle.ts",
    "yedek:geri-yukle": "tsx scripts/firestoreGeriYukle.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource/instrument-serif": "^5.2.8",
    "date-fns": "^4.1.0",
    "firebase": "^13.2.0",
    "lucide-react": "1.68.0",
    "motion": "^14.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.6",
    "zustand": "^5.0.16"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.4",
    "re2js": "^2.8.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "autoprefixer": "^10.6.2",
    "dotenv": "^17.2.3",
    "eslint": "^10.14.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.34.2",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  }
}
